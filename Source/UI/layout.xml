<Component xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		   xsi:noNamespaceSchemaLocation="jive_layout.xsd"
		   display="grid" grid-template-rows="1fr 1fr 1fr 1fr" grid-template-columns="1fr"
		   width="400" height="400">

	<ComboBox id="combo" width="80" height="40"
			  grid-row="1 / span 1" justify-self="centre">
		<Option text="try" enabled="true"/>
		<Option text="this" enabled="true"/>
	</ComboBox>

	<!--<Text text="ADSR envelope" grid-row="2 / span 1" grid-column="1 / span 3"
		  align-self="centre"/>-->

	<Component grid-column="1 / span 3" grid-row="3 / span 1"
			   display="grid" 
			   grid-template-rows="1fr 1fr 1fr 1fr" grid-template-columns="1fr 1fr">
		<Slider id="_attack" grid-column="1 / span 1" grid-row="1 / span 1"/>
		<Text text="Attack" grid-column="2 / span 1" grid-row="1 / span 1" justification="centred"/>
		
		<Slider id="_decay" grid-column="1 / span 1" grid-row="2 / span 1"/>
		<Text text="Decay" grid-column="2 / span 1" grid-row="2 / span 1" justification="centred"/>

		<Slider id="_sustain" grid-column="1 / span 1" grid-row="3 / span 1"/>
		<Text text="Sustain" grid-column="2 / span 1" grid-row="3 / span 1" justification="centred"/>
		
		<Slider id="_release" grid-column="1 / span 1" grid-row="4 / span 1"/>
		<Text text="Release" grid-column="2 / span 1" grid-row="4 / span 1" justification="centred"/>
	</Component>

</Component>